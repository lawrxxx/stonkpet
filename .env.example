# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# Nothing here is NEXT_PUBLIC_ unless it is safe for the browser.

# --- Chain (milestone 2) ---
# "sepolia" (default, mock stocks) or "mainnet" (real Coinbase tokenized stocks)
NEXT_PUBLIC_CHAIN=sepolia
# CDP Paymaster endpoint from portal.cdp.coinbase.com (server-side proxy recommended)
CDP_PAYMASTER_URL=
# Builder Code from dashboard.base.org. Defaults to stonkpet's bc_h8bwov26; set only to override.
NEXT_PUBLIC_BUILDER_CODE=

# --- AI (milestone 3) ---
ANTHROPIC_API_KEY=

# --- Trading (milestone 4, mainnet only) ---
ZERO_EX_API_KEY=

# --- Database (milestone 2+) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Autopilot cron (milestone 6) ---
CRON_SECRET=
